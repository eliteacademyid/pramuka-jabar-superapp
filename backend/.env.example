DATABASE_URL=postgresql://postgres@localhost:5432/db_pramuka_jabar
SECRET_KEY=ganti-dengan-output-dari-python-c-import-secrets-print-secrets-token-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=False
ENVIRONMENT=development

# CORS: daftar origin yang diizinkan, pisahkan dengan koma.
# JANGAN gunakan * jika API menggunakan Authorization header / credentials.
# Production contoh: CORS_ORIGINS=https://app.pramuka-jabar.id,https://admin.pramuka-jabar.id
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
