DATABASE_URL=postgresql://postgres@localhost:5432/db_pramuka_jabar
SECRET_KEY=ganti-dengan-secret-key-panjang-dan-random
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=False
ENVIRONMENT=development

# CORS: daftar origin yang diizinkan, pisahkan dengan koma (tanpa spasi).
# JANGAN gunakan * jika API menggunakan Authorization header / credentials.
# Contoh production: CORS_ORIGINS=https://app.pramuka-jabar.id,https://admin.pramuka-jabar.id
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
